# Copy to .env (gitignored) and fill in. Bun loads .env from the directory the
# portal CLIs run from, which is the repo root when /scrape calls them.

# reed-search: free key from https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=

# adzuna-search: free app id + key from https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
